htmlcov/

# Runs: ignore everything, then whitelist nature-final outputs
runs/*
!runs/nature-final/
runs/nature-final/sandbox/
runs/nature-final/workspace/
runs/nature-final/inputs/
runs/nature-final/logs/
runs/nature-final/artifacts/package_manifest.json
runs/nature-final/artifacts/raw_package_manifest.json
runs/nature-final/artifacts/execution_manifest.json

# Example package: exclude large data dirs
examples/*/source_data/
examples/*/results/
examples/*/openalex/
examples/*/model/
examples/*/paper.pdf
